# ===================================================================
# /decrypt/.htaccess
# Basic Auth WYŁĄCZONY — ochronę przejmuje auth.php (sesja PHP)
# ===================================================================

Require all granted

Options -Indexes

# ===================================================================
# BLOKADA BEZPOŚREDNIEGO DOSTĘPU DO ENDPOINTÓW
# ===================================================================

# log.php tylko przez POST (PHP obsługuje to wewnętrznie, ale dla pewności)
<FilesMatch "^(log)\.php$">
    Require all granted
</FilesMatch>

# ===================================================================
# NAGŁÓWKI BEZPIECZEŃSTWA (nadpisują główny .htaccess)
# ===================================================================

<IfModule mod_headers.c>
    # Panel nie może być osadzany nigdzie
    Header always set X-Frame-Options "DENY"

    # CSP z obsługą Google Fonts
    Header always set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self'; frame-ancestors 'none'"
</IfModule>
