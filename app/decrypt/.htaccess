# ===================================================================
# /decrypt/.htaccess
# Basic Auth WYŁĄCZONY — ochronę przejmuje auth.php (sesja PHP)
# ===================================================================

Require all granted

Options -Indexes

# ===================================================================
# BLOKADA BEZPOŚREDNIEGO DOSTĘPU DO ENDPOINTÓW
# ===================================================================

# log.php tylko przez POST (PHP obsługuje to wewnętrznie, ale dla pewności)
<FilesMatch "^(log)\.php$">
    Require all granted
</FilesMatch>

# timelock.php to biblioteka (require z innych plików) — nie ma być wywoływany z przeglądarki
<FilesMatch "^timelock\.php$">
    Require all denied
</FilesMatch>

# ===================================================================
# NAGŁÓWKI BEZPIECZEŃSTWA (nadpisują główny .htaccess)
# ===================================================================

<IfModule mod_headers.c>
    # Panel nie może być osadzany nigdzie
    Header always set X-Frame-Options "DENY"

    # CSP z obsługą Google Fonts
    Header always set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self'; frame-ancestors 'none'"

    # Nagłówki dodane w v3.1.4 (wzmocnienie; identyczne wartości w głównym .htaccess nie szkodzą)
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"

    # Wymusza brak cache'owania odpowiedzi z tego katalogu — dotyczy m.in.
    # download.php (pobieranie bazy haseł) i panelu z odszyfrowanym sekretem.
    # Żadna z tych odpowiedzi nie powinna być przechowywana przez żadnego
    # pośrednika (przeglądarkę, CDN, proxy). Jeśli masz też ogólną regułę
    # Cache-Control w nadrzędnym .htaccess (np. "public, max-age=..."), ta
    # reguła ją nadpisuje dla tego katalogu, bo jest bliżej "liścia" w
    # hierarchii katalogów Apache.
    Header set Cache-Control "no-store, no-cache, must-revalidate"
    Header set Pragma "no-cache"
</IfModule>
