# Czcionki lokalne: długi cache i poprawny typ MIME.
# Nadpisuje Cache-Control: no-store ustawiony dla całego katalogu aplikacji,
# bo bez tego czcionki byłyby pobierane przy każdym wejściu na stronę.
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.woff2$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header unset Pragma
    </FilesMatch>
    <FilesMatch "\.css$">
        Header set Cache-Control "public, max-age=86400"
        Header unset Pragma
    </FilesMatch>
</IfModule>
